# Ignore everything by default, then allow only the files we want to track.
# This keeps new files out of git unless we add them here on purpose.
*
!.gitignore

!agents/
!agents/AGENTS.md
!agents/docs/
!agents/docs/**
!agents/skills/
!agents/skills/coding-standards-general/
!agents/skills/coding-standards-general/SKILL.md
!agents/skills/coding-standards-react/
!agents/skills/coding-standards-react/SKILL.md
!agents/skills/coding-standards-typescript/
!agents/skills/coding-standards-typescript/SKILL.md
!agents/.skill-lock.json

!claude/
!claude/CLAUDE.md
!claude/skills/
